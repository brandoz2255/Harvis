# Document sandbox: runs model-written python-pptx / python-docx / openpyxl code and
# renders the results to page images with LibreOffice. It replaces executing that
# code inside the backend, which holds every secret and the docker socket.
# Hardening (read-only root, no capabilities, no network route out) is in
# docker-compose.yaml; sandbox_runner/child.py adds per-job limits and a seccomp filter.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-impress libreoffice-calc libreoffice-writer \
        fonts-dejavu-core fonts-dejavu-extra fonts-liberation2 fonts-noto-cjk tini \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /usr/share/doc /usr/share/man

# Versions match requirements-core.txt's installs in the backend image, so a script
# that works here works the same way anywhere else Harvis runs it.
RUN pip install --no-cache-dir \
        python-pptx==1.0.2 \
        python-docx==1.2.0 \
        openpyxl==3.1.5 \
        reportlab==5.0.1 \
        pypdfium2==5.13.0 \
        pillow==12.3.0 \
        numpy==2.5.2 \
        pandas==2.3.3 \
        matplotlib==3.10.8

# tini runs as the sandbox uid too, so a job could read /proc/1/environ and, where the host
# allows it, write /proc/1/mem. Execute-only makes the kernel start it non-dumpable (the kernel
# does not dump a binary the caller cannot read), which closes both. Hosts that set
# fs.suid_dumpable=1 (a debugging setting) override that.
RUN chmod 0711 /usr/bin/tini

RUN groupadd -g 1001 sandbox && useradd -u 1001 -g 1001 -d /tmp -s /usr/sbin/nologin sandbox

WORKDIR /opt/sandbox
COPY sandbox_runner ./sandbox_runner

USER 1001:1001
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
EXPOSE 8080
# tini is PID 1: a killed job leaves orphaned children that need reaping, or they stay
# zombies and eat the pids limit. The server must not reap them itself, it waits on its own.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "sandbox_runner.server"]
