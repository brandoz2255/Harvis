# Harvis AI Backend Environment Variables
# Copy this file to .env and fill in your values

# Database connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# Local Ollama API key (for your local/k8s Ollama instance)
OLLAMA_API_KEY=your-local-ollama-api-key

# External Ollama endpoint (for large models like qwen3:235b)
# This can be an ngrok URL, cloud endpoint, or another server running Ollama
EXTERNAL_OLLAMA_URL=https://your-ollama.example.com
EXTERNAL_OLLAMA_API_KEY=your-external-ollama-api-key

# Gemini API key (optional, for Gemini model support)
GEMINI_API_KEY=your-gemini-api-key

# RAG configuration
RAG_EMBEDDING_MODEL=qwen3-embedding:4b-q4_K_M

# OpenClaw integration
OPENCLAW_GATEWAY_TOKEN=your-openclaw-gateway-token
OPENCLAW_GATEWAY_TOKEN_BUNDLED=your-bundled-openclaw-gateway-token
OPENCLAW_URL=ws://openclaw:18789
OPENCLAW_BUNDLED_URL=ws://openclaw:18789
OPENCLAW_CONFIG_SET=bundled
OPENCLAW_MODE=bundled

# Moonshot / Kimi K2.5
MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Fast Ollama model for main-chat workspace intent detection (when MOONSHOT_API_KEY is unset).
# DISCORD_FAST_MODEL is still read as a fallback for older deployments.
WORKSPACE_DETECTOR_OLLAMA_MODEL=qwen3.5-32k:latest

# NVIDIA NIM
NVIDIA_API_KEY=your-nvidia-api-key

# Discord bot (OpenClaw channel driver)
DISCORD_BOT_TOKEN=your-discord-bot-token

# ── VibeCode local filesystem ────────────────────────────────────────────────
# Editing YOUR local folder uses the browser's File System Access API (Chromium
# browsers: Chrome/Edge/Brave/Arc). NO env vars, NO mounts, NO hardcoded paths —
# Code → Open folder… pops your OS file picker and edits land back in your folder.
#
# Optional power-user attach (bind-mount an allowlisted repo into the backend):
# HARVIS_ATTACH_REPO=/path/to/your/git/repo
# HARVIS_FS_BROWSE_ROOT_HOST=/path/to/parent/of/repos
# HARVIS_FS_BROWSE_ROOT_LABEL=Projects
