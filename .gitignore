err.txt
# k8s secret manifest (plural variant — singular already ignored above)
k8s-manifests/overlays/prod/openclaw-secrets.yaml
# vendored ComfyUI runtime + SD models (13GB) — provider container build context, never repo content
/image-comfy/
# TTS/STT scratch output. NOTE: python_back_end/harvis_voice.mp3 is NOT scratch —
# it is the voice-cloning reference audio qwen3_tts.py and vibecoding/commands.py
# read at runtime, so it stays tracked. Only name the throwaways here.
/temp_response.wav
python_back_end/test_segment_*.wav
# research BM25/fetch cache — runtime state, rebuilt on demand
python_back_end/research_cache/
# SkillOpt corpus + candidates — mined from real user runs (task briefs are user content).
# Regenerate with ./scripts/skillopt-offline.sh; never commit.
/data/skillopt/
# Database dumps written by database-backup/backup.sh — a full copy of the live
# database: user rows, password hashes, chat history, stored provider credentials.
# The scripts are tracked; what they produce never is.
database-backup/backups/
