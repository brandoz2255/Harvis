.obsidian/
harvis-brain/

# skills/Harvis/ and skills/Shared/ are the source of truth.
# openclaw/skills/ is generated by ci_openclaw_pipeline.sh — do not edit directly.
openclaw/skills/

# Ignore all Python cache directories
python_back_end/**/__pycache__/
python_back_end/**/*.pyc
python_back_end/**/*.pyo
python_back_end/**/*.pyd
.env

