k8s-manifests/ci-cd/gitlab-runner-secrets.yaml
!k8s-manifests/ci-cd/gitlab-runner-secrets.yaml.template
k8s-manifests/ci-cd/*-secret.yaml
k8s-manifests/ci-cd/*-secrets.yaml
!k8s-manifests/ci-cd/*-secret.yaml.template
!k8s-manifests/ci-cd/*-secrets.yaml.template

# FluxCD Git credentials and SSH keys
k8s-manifests/flux-system/flux-system-secret.yaml
k8s-manifests/flux-system/git-credentials.yaml
k8s-manifests/flux-system/*-secret.yaml
k8s-manifests/flux-system/*-credentials.yaml
!k8s-manifests/flux-system/*-secret.yaml.template
!k8s-manifests/flux-system/*-credentials.yaml.template
flux-system-key*
id_rsa*
id_ed25519*
id_ed
id_ed.pub
f

# GitHub/GitLab tokens and webhooks
.github-token
.gitlab-token
webhook-secret.txt

# Kubeconfig and kubectl contexts
kubeconfig
kubeconfig.*
.kube/config

# ==========================================
# Personal/Sensitive Files
# ==========================================

# Generated Certificates
certs/

# API Keys and tokens
# Deliberately broad — they must catch credential FILES wherever they land.
**/*api-key*
**/*token*
# FreeToken is the inference server's name, not a secret: its unit files and the
# FT_* env example carry no credentials (the real env lives in ~/.config).
!scripts/freetoken/freetoken*
**/credentials*
# …but not at the cost of source code. A module with one of those words in its NAME is not a
# secret; a secret INSIDE a file is, and that is what the pre-push secret scan is for. Without
# these re-includes, `**/credentials*` silently swallowed
# front_end/open-notebook/src/lib/api/credentials.ts — which broke `npm run build` for the
# open-notebook UI in EVERY fresh clone and took /onb down with it. Nothing surfaced it, because
# an ignored file never shows up in `git status`. Same failure as the bare `build/` rule.
# Data formats a real credential file actually uses (.json/.yaml/.yml/.env) stay ignored.
#
# Directories FIRST, and they are not optional: git never descends into an excluded directory, so
# a `!...*.tsx` re-include can never reach a file inside one. `**/*api-key*` matched the route dir
# `src/app/(dashboard)/settings/api-keys/`, which is how the whole API Keys settings page vanished
# from every fresh clone — silently, because the build still SUCCEEDS and just drops the route.
# Un-ignoring the dir does not un-ignore its contents: a `credentials.json` inside one is still
# caught by the file patterns above.
!**/*api-key*/
!**/*token*/
!**/credentials*/
!**/*api-key*.ts
!**/*api-key*.tsx
!**/*api-key*.js
!**/*api-key*.jsx
!**/*api-key*.py
!**/*api-key*.svelte
!**/*api-key*.md
!**/*token*.ts
!**/*token*.tsx
!**/*token*.js
!**/*token*.jsx
!**/*token*.py
!**/*token*.svelte
!**/*token*.md
!**/credentials*.ts
!**/credentials*.tsx
!**/credentials*.js
!**/credentials*.jsx
!**/credentials*.py
!**/credentials*.svelte
!**/credentials*.md
*.pem
*.key
*.crt
*.p12

# Database dumps with potential sensitive data
*.sql.gz
*.dump
backup-*.sql

# Personal development overrides
docker-compose.override.yml
docker-compose.local.yml
.env.local
.env.personal
.env.secret
.env.omniroute-trial

# IDE and editor files
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ==========================================
# Large Model Files
# ==========================================

# Whisper models (too large for GitHub)
python_back_end/whisper_models/
**/*.pt

# Other large model files
**/*.bin
**/*.safetensors
**/*.ckpt

# openclaw directory (image is pre-built, not tracked). BUT the config, skills,
# scripts, and plugin SOURCE that docker-compose bind-mounts MUST ship: a missing
# mount source becomes an empty dir, openclaw reads a directory as its config file
# (EISDIR) and crashloops, and backend depends_on: openclaw — so a fresh clone
# starts NOTHING. Re-included 2026-07-22 after the first Windows install E2E.
openclaw/
# Un-ignore each dir, then its whole subtree with /** (a nested `!parent/child/`
# alone cannot re-open a subtree the broad `openclaw/` rule already pruned).
!openclaw/config/
!openclaw/config/**
!openclaw/skills/
!openclaw/skills/**
!openclaw/scripts/
!openclaw/scripts/**
!openclaw/plugins/
!openclaw/plugins/**
# ...then re-ignore what must NOT ship, AFTER the broad re-includes above:
openclaw/**/node_modules/
# bundled/exec-approvals.json carries a default token and is no longer mounted.
openclaw/config/bundled/exec-approvals.json

# OpenCode engine sidecar: the config dir (Dockerfile / opencode.json / entrypoint.sh)
# IS tracked — only a nested vendored OpenCode source clone is ignored.
opencode/opencode/

# SGLang fork vendor clone (gitignored — patched locally, not committed)
vendor/sglang-H/

# ==========================================
# OpenClaw secrets — apply manually via kubectl, never commit
# ==========================================
k8s-manifests/overlays/prod/openclaw-secret.yaml
# (removed a bare `mascot/` pattern here 2026-07-19 — added 2026-03 alongside an
#  unrelated change, it matched ANY mascot/ directory tree-wide and silently blocked
#  assets/mascot/ and the mascot component dir. Same class as the bare `build/` bug.
#  It protected nothing: no other mascot/ dir exists, and tracked mascot files live
#  under mascots/ or common/.)

# graphify code map — local, regenerable; do NOT commit (per Nexusys setup)
graphify-out/

