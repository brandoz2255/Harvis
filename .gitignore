# Obsidian workspace config — local editor state, not project files
.obsidian/
harvis-brain/

# skills/Harvis/ and skills/Shared/ are the source of truth.
# openclaw/skills/ is generated by ci_openclaw_pipeline.sh — do not edit directly.
openclaw/skills/

# Ignore all Python cache directories
python_back_end/**/__pycache__/
python_back_end/**/*.pyc
python_back_end/**/*.pyo
python_back_end/**/*.pyd
.env
# Ignore .gradio folder
.gradio/
__pycache__

# ==========================================
# FluxCD and Kubernetes Secrets Protection
# ==========================================

# Ignore personal values files with secrets/API keys
**/values-personal.yaml
**/values-secret.yaml
**/values-local.yaml
**/secrets.yaml
**/secret-*.yaml
k8s-manifests/base/secrets.yaml

# Ignore Helm chart values with personal info
harvis-helm-chart/values-production.yaml
harvis-helm-chart/values-staging.yaml
harvis-helm-chart/charts/
harvis-helm-chart/*.tgz

# Ignore FluxCD personal configurations
flux-config/**/overlays/personal/
flux-config/**/secrets/
flux-config/**/*-secret.yaml
flux-config/**/external-secret*.yaml

# ==========================================
# CI/CD Secrets and Credentials
# ==========================================

# GitLab Runner secrets (templates are .yaml.template, actual secrets are ignored)
k8s-manifests/ci-cd/gitlab-runner-secrets.yaml
!k8s-manifests/ci-cd/gitlab-runner-secrets.yaml.template
k8s-manifests/ci-cd/*-secret.yaml
k8s-manifests/ci-cd/*-secrets.yaml
!k8s-manifests/ci-cd/*-secret.yaml.template
!k8s-manifests/ci-cd/*-secrets.yaml.template

# FluxCD Git credentials and SSH keys
k8s-manifests/flux-system/flux-system-secret.yaml
k8s-manifests/flux-system/git-credentials.yaml
k8s-manifests/flux-system/*-secret.yaml
k8s-manifests/flux-system/*-credentials.yaml
!k8s-manifests/flux-system/*-secret.yaml.template
!k8s-manifests/flux-system/*-credentials.yaml.template
flux-system-key*
id_rsa*
id_ed25519*
id_ed
id_ed.pub
f

# GitHub/GitLab tokens and webhooks
.github-token
.gitlab-token
webhook-secret.txt

# Kubeconfig and kubectl contexts
kubeconfig
kubeconfig.*
.kube/config

# ==========================================
# Personal/Sensitive Files
# ==========================================

# Generated Certificates
certs/

# API Keys and tokens
**/*api-key*
**/*token*
**/credentials*
*.pem
*.key
*.crt
*.p12

# Database dumps with potential sensitive data
*.sql.gz
*.dump
backup-*.sql

# Personal development overrides
docker-compose.override.yml
docker-compose.local.yml
.env.local
.env.personal
.env.secret

# IDE and editor files
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ==========================================
# Large Model Files
# ==========================================

# Whisper models (too large for GitHub)
python_back_end/whisper_models/
**/*.pt

# Other large model files
**/*.bin
**/*.safetensors
**/*.ckpt

# openclaw directory (image is pre-built, not tracked)
# Anchored to the repo-root vendored tree only — an unanchored "openclaw/"
# also matches app dirs named openclaw (e.g. front_end/.../app/api/openclaw/,
# components/openclaw/) and would silently drop tracked frontend code.
/openclaw/
# ...but track our local config and skills placeholder
!/openclaw/config/
!/openclaw/config/openclaw.json
!/openclaw/config/exec-approvals.json
!openclaw/skills/
!openclaw/skills/.gitkeep

# OpenCode repo clone (embedded git repo - not tracked)
opencode/
opencode/opencode/

# SGLang fork vendor clone (gitignored — patched locally, not committed)
vendor/sglang-H/

# ==========================================
# OpenClaw secrets — apply manually via kubectl, never commit
# ==========================================
k8s-manifests/overlays/prod/openclaw-secret.yaml
mascot/
