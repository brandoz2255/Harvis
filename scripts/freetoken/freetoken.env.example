# Copy to ~/.config/freetoken.env and edit. Read by freetoken.service (systemd --user).
FT_HOME=/home/you/freetoken
FT_MODEL=models/Qwen3.6-35B-A3B-NVFP4
# 172.17.0.1 = Docker bridge only: the Harvis container reaches it as
# host.docker.internal, the LAN cannot. Use 0.0.0.0 only behind a token proxy.
FT_HOST=172.17.0.1
FT_PORT=1919
FT_MAX_RUNNING=2
# KV-cache floor in tokens. The K+V for this GDN-hybrid model is ~20 KB/token, so
# 16384 costs ~0.3 GB and ~10 expert slots; 4096 left grounded chats with no room.
FT_KV_RESERVE=16384
# 0.95 left 0.16-0.28 GB of runtime headroom, and a 4k-token prefill OOM-killed the
# scheduler. 0.90 plus a 2k prefill chunk is the 8 GB setting that survives it.
FT_MEMORY_RATIO=0.90
FT_MOE_THREADS=6
FT_MAX_PREFILL=2048
# Minutes without a completed request before freetoken-idle.timer stops the service.
FT_IDLE_MIN=30
# freetoken-watchdog.timer: how often it may spend a one-token request proving the
# scheduler is alive, how many restarts it may make in a rolling hour before it gives
# up and just logs, and how long that probe may take before it counts as a failure.
FT_WATCHDOG_PROBE_MIN=10
FT_WATCHDOG_MAX_RESTARTS=3
FT_WATCHDOG_PROBE_TIMEOUT=45
